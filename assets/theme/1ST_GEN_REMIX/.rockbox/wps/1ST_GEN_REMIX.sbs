# Theme: 1ST_GEN_REMIX
# Version 1.0
# Last Update: 01/26/2026
# License: CC-BY-SA 3.0
# By: Monica G.
# Description: Theme based on the iPod classic 1st generation's UI with some added features.
# Icons & viewers based on Susan Kare's classic Macintosh icons.
# Code based on: BACKBONE and Pixel Computer by me! which are based on SNARTY by Simon Anden and BONES by Chuck Largo!
# Hold screen is stripped back from the WPS to make room for album art.

# SBS File

# Disable Status Bar
%wd

# Disable Title
%?Lt<|>

# Preload Fonts
%Fl(2,18-TrimpodUI.fnt)
%Fl(3,20-TrimpodUI.fnt)

#Preload Images
%xl(sad_mac,sad_mac.bmp,0,0)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(repeat,repeat_status.bmp,0,0,5)
%xl(shuffle,shuffle.bmp,0,0,2)
%xl(battery,battery.bmp,0,0,5)
%xl(lock,lock.bmp,0,0)

# Display Viewports
%?if(%cs, =, 21)<%VI(clearScreen)%Vd(usbScreen)|%Vd(mainMenu)<%VI(mainMenu)%Vd(mainMenu)>>

# Header button-legend (the standard): when a page sets a legend (%Tl non-empty)
# overlay it on the header.  Conditionally DISPLAYED (like usbScreen), not a
# content-conditional, so when hidden it doesn't clear over the header -- the
# normal header (centred project title) is left exactly as it is.
%?Tl<%Vd(legend)|>

# Clear Screen
%Vi(clearScreen,0,0,1,1,-)

## Main Menu ##

# 512x384 layout. Font slot 1 remains the user-selected UI font.
%Vi(mainMenu,8,64,496,284,1)

# Play/Pause Icons
%Vl(mainMenu,16,11,44,44,-)
%?if(%mp, >, 1)<%xd(playmodes,%mp)|>

# Title (shared status bar): Now Playing (%cs=2) shows the playlist name; otherwise
# the current screen's title (%Lt) -- the localized fork title on the main menu,
# "Settings"/etc elsewhere, falling back to TrimPod(RUS) if unset. Parentheses
# are escaped because they are control characters in Rockbox skin source. Hold is shown by the lock icon (left
# of the battery), not the title.  Viewport centred (x 65..255) so %ac is centred.
# The original 20px Chicago role is centred against the pixel-art icons.
%Vl(mainMenu,104,18,280,27,3)
%?if(%cs, =, 2)<%ac%s%?pn<%t(5)%Sx(Now Playing);%t(5)%pn|%ac%Sx(Now Playing)>|%?Lt<%ac%s%Lt|%acTrimPod%(RUS%)>>

# Battery
%Vl(mainMenu,424,14,80,36,2)
%?if(%bl, >, 88)<%xd(battery,5)|%?if(%bl, >, 63)<%xd(battery,4)|%?if(%bl, >, 38)<%xd(battery,3)|%?if(%bl, >, 13)<%xd(battery,2)|%xd(battery,1)>>>>

# Hold lock: a padlock (lock.bmp) shown just left of the battery while the side
# switch is engaged (%mh).
%Vl(mainMenu,392,14,28,36,-)
%?mh<%xd(lock)|>

# Line
%Vl(mainMenu,8,58,496,3,-)
%dr(0,0,496,3)

# Now Playing (bottom scroller on menu screens; hidden on the WPS, which draws
# its own track info/times there). The 29px font has room for fullwidth glyphs.
%Vl(mainMenu,8,356,496,22,2)
%?if(%cs, =, 2)<|%ac%?mp<|%s%?it<%it|%fn>%?ia< - %ia>|>>

## Header Button-Legend (overlay, displayed via %Vd when a page sets %Tl) ##

# Left-aligned button labels over the header; the title is covered while shown.
# Same vertical centring as the title it covers.
%Vl(legend,16,18,392,27,3)
%Tl

## USB Screen ##

# USB Screen Viewport
%Vl(usbScreen,0,0,512,384,-)

# Time / Battery (numerical)
%Vl(usbScreen,64,18,384,27,3)
%t(10)%ac%?cf<%ac%cH|%cl>:%cM%?cf<| %cP>;%t(10)%ac%Sx(Battery): %bl%%

# Battery
%Vl(usbScreen,424,14,80,36,2)
%?if(%bl, >, 88)<%xd(battery,5)|%?if(%bl, >, 63)<%xd(battery,4)|%?if(%bl, >, 38)<%xd(battery,3)|%?if(%bl, >, 13)<%xd(battery,2)|%xd(battery,1)>>>>

# Line
%Vl(usbScreen,8,58,496,3,-)
%dr(0,0,496,3)

# USB Mac Icon
%Vl(usbScreen,314,112,190,240,-)
%xd(sad_mac)

# USB Text
%Vl(usbScreen,8,160,300,28,3)
%ac%Sx(USB Connected)%Vs(invert)

# USB Eject Box
%Vl(usbScreen,8,208,336,43,-)
%dr(0,0,336,2)%dr(0,0,2,42)%dr(334,0,2,42)%dr(0,41,336,2)

# Eject Warning
%Vl(usbScreen,10,226,328,22,2)
%ac%t(1)! %Sx(Eject Before Disconnecting) !;%t(.1)%ac
